# ==========================================
# HQA 통합 런타임 설정 예시
# 실제 키는 로컬 .env 또는 배포 환경변수에만 설정하세요.
# 기존 .env를 덮어쓰지 말고 필요한 항목만 추가하세요. 키 값은 커밋하지 않습니다.
# Python은 .env-ai가 있으면 .env 대신 해당 파일을 로드합니다.
# ==========================================

# ── 필수: 공시 / 재무 / 종목 고유번호 수집 ──
# OpenDART 공시 목록, 기업행사, 재무제표, stock_code -> corp_code 매핑에 사용합니다.
# 키 설정과 별도로 수집 대상의 corp_code 매핑이 필요합니다.
# 매핑 CSV 수집 명령: python -m scripts.data.corp_codes --help
DART_API_KEY=

# ── 필수: 종목 일봉 / 시장·업종 지수 수집 ──
# KRX 주식 일별매매정보(KOSPI/KOSDAQ)와 지수 일별시세정보에 사용합니다.
# 사용 엔드포인트: sto/stk_bydd_trd, sto/ksq_bydd_trd,
#                  idx/kospi_dd_trd, idx/kosdaq_dd_trd
# 해당 서비스 이용 승인이 있는 키가 필요합니다. 자세한 내용: docs/market-context-data.md
# 기존 KRX_API_KEY도 지원하지만 두 이름에 서로 다른 키를 설정하지 마세요.
KRX_OPEN_API_KEY=

# ── 뉴스 / 종목토론글: 현재 별도 API 키 없음 ──
# 현재 구현은 네이버 웹 크롤러입니다. NAVER_CLIENT_ID / NAVER_CLIENT_SECRET은 사용하지 않습니다.
# 별도 뉴스 API는 아직 연결되어 있지 않으므로 미사용 키 항목을 두지 않습니다.

# ── 필수: OpenAI 분석 (데이터 수집만 실행할 때는 불필요) ──
# Production analysis uses OpenAI Responses. No automatic provider fallback.
LLM_PROVIDER=openai
OPENAI_API_KEY=

# ── 분석 호출 / 예산 설정 ──
# RPM/TPM은 예시이며 실제 OpenAI 프로젝트 한도에 맞춰 조정하세요.
HQA_LLM_MAX_CONCURRENCY=8
HQA_LLM_RPM=120
HQA_LLM_TPM=200000
HQA_LLM_TIMEOUT_SECONDS=45
HQA_LLM_QUEUE_TIMEOUT_SECONDS=45
HQA_LLM_RISK_MANAGER_MAX_OUTPUT_TOKENS=12000
HQA_LLM_MONTHLY_BUDGET_USD=100
HQA_LLM_OPERATING_TARGET_USD=90
HQA_LLM_BUDGET_PATH=./data/llm_budget.sqlite3
HQA_PAPER_AUDIT_PATH=./data/paper_audit.sqlite3

# ai-data-main / rag-data-pipeline 산출물이 함께 저장될 기본 데이터 루트입니다.
# 상대 경로는 프로젝트 루트를 기준으로 해석됩니다.
HQA_DATA_DIR=./data

# --- Optional local development: set LLM_PROVIDER=ollama explicitly ---
# 설치: https://ollama.com/download
# 실행: OLLAMA_HOST=127.0.0.1:11435 ollama serve
OLLAMA_BASE_URL=http://localhost:11435

# Agent별 모델. 비워두면 llm_config.py 기본값을 사용합니다.
OLLAMA_ANALYST_MODEL=gemma4:12b
OLLAMA_SUMMARY_MODEL=gemma4:e4b
OLLAMA_QUANT_MODEL=gemma4:12b
OLLAMA_CHARTIST_MODEL=qwen3.5:9b
OLLAMA_RISK_MANAGER_MODEL=gemma4:12b

# 선택: retrieval 연결만 확인하는 스모크 테스트 모드
# 운영 환경에서는 사용하지 않습니다.
# LLM_PROVIDER=mock

# ── 선택: 데이터/출력 경로 재정의 ──
# HQA_TRACES_DIR=./data/traces
# HQA_ORDERS_DIR=./data/orders

# ── 선택: 검색 / retrieval API ──
# 별도 검색 도구용입니다. 현재 공통 분석과 공시·뉴스 수집에는 필요하지 않습니다.
TAVILY_API_KEY=

# ── 선택: OCR / reranker 제공자 ──
# 별도 설정이 없으면 기본적으로 비활성화되거나 로컬 전용으로 동작합니다.
OCR_PROVIDER=local
ENABLE_OCR=false
# UPSTAGE_API_KEY=

RERANKER_PROVIDER=local
# COHERE_API_KEY=

# ── 선택: Python 직접 도구용 KIS 모의투자 API ──
# Python에서 KIS 현재가/호가/잔고/주문 도구를 직접 사용할 때만 설정합니다.
# 아래 값은 백엔드 사용자별 자동매매 계좌로 자동 등록되지 않습니다.
# PAPER 자동매매 계좌는 로그인 후 PUT /api/v1/auth/me/kis에서 별도 등록합니다.
# AI 공통 분석에는 사용자별 KIS 키를 전달하지 않습니다. REAL 계좌는 허용하지 않습니다.
# 계좌번호는 12345678, 12345678-01, 1234567801 형식을 지원합니다.
# 8자리만 입력하면 계좌상품코드는 01로 보완합니다.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# The autonomous plan pipeline rejects REAL accounts, including REAL keys.
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=

# ── 필수: PAPER 서비스 간 인증 / 백엔드 암호화 ──
# 외부 API에서 발급받는 키가 아닙니다. 각각 별도로 생성한 비밀값을 사용하세요.
# AI 서버, 백엔드, 분석 스케줄러, monitor에 동일한 내부 인증 토큰을 설정합니다.
HQA_INTERNAL_TOKEN=
# 백엔드 DB의 사용자별 KIS 키 암호화에 사용합니다. 백엔드 시작 시 필수입니다.
# 기존 암호화 데이터가 있으면 키를 임의로 교체하지 마세요. 복호화할 수 없게 됩니다.
# Docker Compose의 개발용 기본값에 의존하지 말고 명시적으로 설정하세요.
HQA_KIS_ENC_KEY=

# ── 서버 주소 / 선택적 관측성 설정 ──
REDIS_URL=redis://localhost:6379/0
BACKEND_INTERNAL_BASE_URL=http://localhost:8000
AI_SERVER_URL=http://localhost:8001
# Set only after offline validation to publish PAPER plans to the backend.
# BACKEND_SIGNAL_URL=http://localhost:8000/api/v1/internal/trading/signals
# In Docker Compose use http://backend:8000/api/v1/internal/trading/signals.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=hqa-ai

# ==========================================
# 실행 시 참고사항
# 1. 데이터 수집: DART_API_KEY, KRX_OPEN_API_KEY와 대상 corp_code 매핑이 필요합니다.
# 2. PAPER 분석/주문: OPENAI_API_KEY, HQA_INTERNAL_TOKEN, HQA_KIS_ENC_KEY와
#    백엔드에 등록한 사용자별 PAPER 계좌가 필요합니다. 실제 주문 발행 설정은 위에서 별도 활성화합니다.
#    설정 및 검증 절차: docs/luna-paper-runtime.md
# 3. Playwright 기반 종목토론방 크롤링을 쓰려면:
#    playwright install chromium
# 4. Ollama 기반 실행 시에는 에이전트 데모를 돌리기 전에
#    설정한 모델을 미리 pull 해두는 것을 권장합니다.
# ==========================================
