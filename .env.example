# ==========================================
# HQA 통합 런타임 설정 예시
# 실제 키는 로컬 .env 또는 배포 환경변수에만 설정하세요.
# 기존 .env를 덮어쓰지 말고 필요한 항목만 추가하세요. 키 값은 커밋하지 않습니다.
# Python은 .env-ai가 있으면 .env 대신 해당 파일을 로드합니다.
# ==========================================

# ── 필수: 공시 / 재무 / 종목 고유번호 수집 ──
# OpenDART 공시 목록, 기업행사, 재무제표, stock_code -> corp_code 매핑에 사용합니다.
# 키 설정과 별도로 수집 대상의 corp_code 매핑이 필요합니다.
# 매핑 CSV 수집 명령: python -m scripts.data.corp_codes --help
DART_API_KEY=

# ── 필수: 종목 일봉 / 시장·업종 지수 수집 ──
# KRX 주식 일별매매정보(KOSPI/KOSDAQ)와 지수 일별시세정보에 사용합니다.
# 사용 엔드포인트: sto/stk_bydd_trd, sto/ksq_bydd_trd,
#                  idx/kospi_dd_trd, idx/kosdaq_dd_trd
# 해당 서비스 이용 승인이 있는 키가 필요합니다. 자세한 내용: docs/market-context-data.md
# 기존 KRX_API_KEY도 지원하지만 두 이름에 서로 다른 키를 설정하지 마세요.
KRX_OPEN_API_KEY=

# ── 뉴스 / 종목토론글: 현재 별도 API 키 없음 ──
# 현재 구현은 네이버 웹 크롤러입니다. NAVER_CLIENT_ID / NAVER_CLIENT_SECRET은 사용하지 않습니다.
# 별도 뉴스 API는 아직 연결되어 있지 않으므로 미사용 키 항목을 두지 않습니다.

# ── 필수: 분석 LLM (데이터 수집만 실행할 때는 불필요) ──
# 하나만 고릅니다. 다른 회사 모델로 자동 전환하지 않습니다. Compose의 ai 서비스도 이 값을 씁니다.
#   openai    : gpt-5.6-luna (OPENAI_API_KEY)
#   anthropic : Claude (ANTHROPIC_API_KEY). Claude Max·Team 요금제는 매달 API 크레딧이 포함됩니다.
#               claude.ai 설정 > 결제 > API 크레딧에서 Console 조직을 연결하고, 그 조직에서 키를 만듭니다.
#   claude_plan: Claude 구독(Pro·Max) 한도로 분석합니다. 이 PC의 Claude Code CLI(2.1.205 이상)를 부릅니다.
#               무인 실행에는 `claude setup-token`으로 만든 토큰을 CLAUDE_CODE_OAUTH_TOKEN에 넣습니다.
#               구독 한도는 claude.ai·Claude Code와 같이 쓰고, 구독자 본인 사용만 허용됩니다.
#               Compose 컨테이너에는 CLI가 없으므로 호스트에서 직접 실행할 때만 씁니다.
#               구독에는 분당 토큰 한도가 공개되어 있지 않으니 HQA_LLM_TPM을 2000000 정도로 올리세요.
#               기본 200000이면 첫 사이클의 전문가 호출이 대기열에서 시간 초과로 실패합니다.
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# HQA_CLAUDE_CLI=claude
# Claude 모델: claude-opus-5-5(기본), claude-sonnet-5-5, claude-haiku-5-5. 역할별로 따로 지정할 수 있습니다.
# (ANTHROPIC_MODEL은 Claude Code가 쓰는 이름이라 읽지 않습니다.)
# HQA_CLAUDE_MODEL=claude-opus-5-5
# HQA_CLAUDE_RISK_MANAGER_MODEL=claude-opus-5-5
# 생각 깊이: 기본은 전문가·요약 low, RiskManager medium (low|medium|high|xhigh|max)
# HQA_CLAUDE_RISK_MANAGER_EFFORT=medium
# 안전 분류기가 거절한 요청을 Claude Opus 5/4.8이 같은 호출 안에서 다시 받습니다(기본 켬, off로 끔).
# HQA_CLAUDE_FALLBACKS=default

# ── 분석 호출 / 예산 설정 ──
# RPM/TPM은 예시이며 실제 OpenAI 프로젝트 또는 Claude Console 조직 한도에 맞춰 조정하세요.
HQA_LLM_MAX_CONCURRENCY=8
HQA_LLM_RPM=120
HQA_LLM_TPM=200000
# 호출 제한 시간 기본값: 전문가·요약 OpenAI 45초 / Claude 120초, RiskManager OpenAI 180초 / Claude 300초.
# HQA_LLM_TIMEOUT_SECONDS=45
# HQA_LLM_RISK_MANAGER_TIMEOUT_SECONDS=180
HQA_LLM_QUEUE_TIMEOUT_SECONDS=45
# 출력 한도(추론·생각 포함) 기본값: 전문가 OpenAI 1200 / Claude 4000, RiskManager OpenAI 12000 / Claude 16000.
# HQA_LLM_RISK_MANAGER_MAX_OUTPUT_TOKENS=12000
# RiskManager 입력 한도(기본 128000). 보유 종목 전부와 신규 최대 5종목을 한 번에 검토합니다.
# HQA_LLM_RISK_MANAGER_MAX_INPUT_TOKENS=128000
HQA_LLM_MONTHLY_BUDGET_USD=100
HQA_LLM_OPERATING_TARGET_USD=90
HQA_LLM_BUDGET_PATH=./data/llm_budget.sqlite3
HQA_PAPER_AUDIT_PATH=./data/paper_audit.sqlite3

# ai-data-main / rag-data-pipeline 산출물이 함께 저장될 기본 데이터 루트입니다.
# 상대 경로는 프로젝트 루트를 기준으로 해석됩니다.
HQA_DATA_DIR=./data

# --- Optional local development: set LLM_PROVIDER=ollama explicitly ---
# 설치: https://ollama.com/download
# 실행: OLLAMA_HOST=127.0.0.1:11435 ollama serve
OLLAMA_BASE_URL=http://localhost:11435

# Agent별 모델. 비워두면 llm_config.py 기본값을 사용합니다.
OLLAMA_ANALYST_MODEL=gemma4:12b
OLLAMA_SUMMARY_MODEL=gemma4:e4b
OLLAMA_QUANT_MODEL=gemma4:12b
OLLAMA_CHARTIST_MODEL=qwen3.5:9b
OLLAMA_RISK_MANAGER_MODEL=gemma4:12b
# Context window for local runs; specialist inputs reach about 12k tokens.
# OLLAMA_NUM_CTX=16384

# 선택: retrieval 연결만 확인하는 스모크 테스트 모드
# 운영 환경에서는 사용하지 않습니다.
# LLM_PROVIDER=mock

# ── 선택: 데이터/출력 경로 재정의 ──
# HQA_TRACES_DIR=./data/traces
# HQA_ORDERS_DIR=./data/orders

# ── 선택: 검색 / retrieval API ──
# 별도 검색 도구용입니다. 현재 공통 분석과 공시·뉴스 수집에는 필요하지 않습니다.
TAVILY_API_KEY=

# ── 선택: OCR / reranker 제공자 ──
# 별도 설정이 없으면 기본적으로 비활성화되거나 로컬 전용으로 동작합니다.
OCR_PROVIDER=local
ENABLE_OCR=false
# UPSTAGE_API_KEY=

RERANKER_PROVIDER=local
# COHERE_API_KEY=

# ── 선택: Python 직접 도구용 KIS 모의투자 API ──
# Python에서 KIS 현재가/호가/잔고/주문 도구를 직접 사용할 때만 설정합니다.
# 아래 값은 백엔드 사용자별 자동매매 계좌로 자동 등록되지 않습니다.
# PAPER 자동매매 계좌는 로그인 후 PUT /api/v1/auth/me/kis에서 별도 등록합니다.
# AI 공통 분석에는 사용자별 KIS 키를 전달하지 않습니다. REAL 계좌는 허용하지 않습니다.
# Docker Compose의 AI 쪽 컨테이너(ai, analysis-scheduler, signal-monitor)에는 이 KIS 값들과
# HQA_KIS_ENC_KEY가 전달되지 않습니다(빈 값으로 덮어씀). 백엔드만 KIS를 호출합니다.
# 계좌번호는 12345678, 12345678-01, 1234567801 형식을 지원합니다.
# 8자리만 입력하면 계좌상품코드는 01로 보완합니다.
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# The autonomous plan pipeline rejects REAL accounts, including REAL keys.
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=

# ── 필수: PAPER 서비스 간 인증 / 백엔드 암호화 ──
# 외부 API에서 발급받는 키가 아닙니다. 각각 별도로 생성한 비밀값을 사용하세요.
# AI 서버, 백엔드, 분석 스케줄러, monitor에 동일한 내부 인증 토큰을 설정합니다.
HQA_INTERNAL_TOKEN=
# 백엔드 DB의 사용자별 KIS 키 암호화에 사용합니다. 백엔드 시작 시 필수입니다.
# 기존 암호화 데이터가 있으면 키를 임의로 교체하지 마세요. 복호화할 수 없게 됩니다.
# Docker Compose의 개발용 기본값에 의존하지 말고 명시적으로 설정하세요.
HQA_KIS_ENC_KEY=
# 백엔드 주문 가능 시간: 평일 09:00-15:30에서 아래 휴장일을 뺍니다. 비워 두면
# src/runner/trading_calendar.py의 평일 휴장일(2026-10 ~ 2027-09)이 기본값이고,
# 설정하면 그 목록 전체를 대체합니다. 특별 세션은 KRX 공지가 나온 날만 넣고
# Python 캘린더의 SPECIAL_CLOSES에도 같이 넣으세요(docs/paper-preflight-checklist.md 8장).
# HQA_KRX_CLOSED_DATES=2026-10-05,2026-10-09,2026-12-25
# HQA_KRX_SPECIAL_SESSIONS=2026-11-19@10:00-16:30

# ── 서버 주소 / 선택적 관측성 설정 ──
REDIS_URL=redis://localhost:6379/0
BACKEND_INTERNAL_BASE_URL=http://localhost:8000
AI_SERVER_URL=http://localhost:8001
# AI 서버 CORS는 기본적으로 꺼져 있습니다. 프론트엔드는 백엔드 /api/v1을 경유하므로
# 브라우저가 AI 서버를 직접 호출할 때만 허용할 origin을 쉼표로 구분해 지정하세요.
# HQA_AI_CORS_ORIGINS=http://localhost:3000
# POST /backtest/results 본문 상한(바이트, 기본 16 MiB, 최소 1024).
# HQA_MAX_BACKTEST_RESULT_BYTES=16777216
# 증거 인덱스 generation 보존: 최신 N개(기본 8, 0이면 삭제 안 함)와 최소 보존 시간.
# HQA_GENERATION_KEEP=8
# HQA_GENERATION_MIN_AGE_HOURS=24
# Set only after offline validation to publish PAPER plans to the backend.
# BACKEND_SIGNAL_URL=http://localhost:8000/api/v1/internal/trading/signals
# In Docker Compose use http://backend:8000/api/v1/internal/trading/signals.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=hqa-ai

# ==========================================
# 실행 시 참고사항
# 1. 데이터 수집: DART_API_KEY, KRX_OPEN_API_KEY와 대상 corp_code 매핑이 필요합니다.
# 2. PAPER 분석/주문: OPENAI_API_KEY, HQA_INTERNAL_TOKEN, HQA_KIS_ENC_KEY와
#    백엔드에 등록한 사용자별 PAPER 계좌가 필요합니다. 실제 주문 발행 설정은 위에서 별도 활성화합니다.
#    설정 및 검증 절차: docs/luna-paper-runtime.md
# 3. Playwright 기반 종목토론방 크롤링을 쓰려면:
#    playwright install chromium
# 4. Ollama 기반 실행 시에는 에이전트 데모를 돌리기 전에
#    설정한 모델을 미리 pull 해두는 것을 권장합니다.
# ==========================================
