[Unit]
Description=HQA strategy runtime evening check (data pull, backend batch results, pending-session retry, alerts)
Wants=network-online.target
After=network-online.target
OnFailure=hqa-strategy-runtime-failure@%n.service

[Service]
Type=oneshot
User=hqa
Group=hqa
WorkingDirectory=/opt/hqa-runtime
EnvironmentFile=/etc/hqa/strategy-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/env bash /opt/hqa-runtime/deploy/strategy-runtime/evening.sh
MemoryMax=2G
TimeoutStartSec=45min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/hqa-runtime/data
ReadOnlyPaths=/var/lib/hqa/data
PrivateTmp=true
UMask=0027
