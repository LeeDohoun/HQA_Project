[Unit]
Description=HQA strategy runtime evening run (data pull, shadow fill, plans, status, alerts)
Wants=network-online.target
After=network-online.target
OnFailure=hqa-strategy-runtime-failure@%n.service

[Service]
Type=oneshot
User=hqa
Group=hqa
WorkingDirectory=/opt/hqa
EnvironmentFile=/etc/hqa/strategy-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/env bash /opt/hqa/deploy/strategy-runtime/evening.sh
MemoryMax=2G
TimeoutStartSec=45min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/hqa/data
PrivateTmp=true
UMask=0027
