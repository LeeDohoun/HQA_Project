[Unit]
Description=HQA OP001 readiness verify: balance and broker-order check; leftovers alert, M8/unknown leftovers block the next buy
Wants=network-online.target
After=network-online.target
OnFailure=hqa-strategy-runtime-failure@%n.service

[Service]
Type=oneshot
User=hqa
Group=hqa
WorkingDirectory=/opt/hqa-runtime
EnvironmentFile=/etc/hqa/strategy-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/env bash /opt/hqa-runtime/deploy/strategy-runtime/readiness.sh verify
MemoryMax=1G
TimeoutStartSec=10min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hqa-runtime/data
ReadOnlyPaths=/var/lib/hqa/data
PrivateTmp=true
UMask=0027
