[Unit]
Description=HQA strategy runtime morning check (FW001 decision seal on trade dates, backend orders)
Wants=network-online.target
After=network-online.target
OnFailure=hqa-strategy-runtime-failure@%n.service

[Service]
Type=oneshot
User=hqa
Group=hqa
WorkingDirectory=/opt/hqa
EnvironmentFile=/etc/hqa/strategy-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/env bash /opt/hqa/deploy/strategy-runtime/morning.sh
MemoryMax=1G
TimeoutStartSec=10min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hqa/data
PrivateTmp=true
UMask=0027
