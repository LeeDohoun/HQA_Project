[Unit]
Description=HQA strategy runtime submit (data pull, binding close NAV, D=25% check, due PAPER batches: CONT_SELL/CONT_BUY)
Wants=network-online.target
After=network-online.target
OnFailure=hqa-strategy-runtime-failure@%n.service

[Service]
Type=oneshot
User=hqa
Group=hqa
WorkingDirectory=/opt/hqa-runtime
EnvironmentFile=/etc/hqa/strategy-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/env bash /opt/hqa-runtime/deploy/strategy-runtime/submit.sh
MemoryMax=1G
TimeoutStartSec=15min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hqa-runtime/data
ReadOnlyPaths=/var/lib/hqa/data
PrivateTmp=true
UMask=0027
