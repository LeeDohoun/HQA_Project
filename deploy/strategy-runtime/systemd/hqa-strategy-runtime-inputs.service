[Unit]
Description=HQA strategy runtime input seal (data pull, binding close NAV, sealed input reference before 08:59)
Wants=network-online.target
After=network-online.target
OnFailure=hqa-strategy-runtime-failure@%n.service

[Service]
Type=oneshot
User=hqa
Group=hqa
WorkingDirectory=/opt/hqa-runtime
EnvironmentFile=/etc/hqa/strategy-runtime.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Seoul
ExecStart=/usr/bin/env bash /opt/hqa-runtime/deploy/strategy-runtime/inputs.sh
MemoryMax=1G
TimeoutStartSec=15min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hqa-runtime/data
ReadOnlyPaths=/var/lib/hqa/data
PrivateTmp=true
UMask=0027
