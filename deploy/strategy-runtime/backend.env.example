# /etc/hqa/backend.env (root:hqa-backend 0640). Names only; secrets are generated on the host
# (openssl rand) and never copied off it. The strategy runtime env repeats HQA_INTERNAL_TOKEN.
ENV=production
PORT=8000
SERVER_ADDRESS=127.0.0.1
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/hqa_runtime
DATABASE_USERNAME=hqa_runtime_backend
DATABASE_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=5
HQA_INTERNAL_TOKEN=
HQA_KIS_ENC_KEY=
SECRET_KEY=
HQA_STRATEGY_ORDERS_ENABLED=false
CORS_ORIGINS=http://localhost:3000
