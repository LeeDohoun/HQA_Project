# /etc/hqa/strategy-runtime.env (root:hqa 0640). Names only; fill values on the host.
# Lab hqa-server layout: this checkout is /opt/hqa-runtime (the collector's /opt/hqa is the frozen
# FW001 tree and must not be touched). HQA_DATA_DIR must be /opt/hqa-runtime/data: the units' only
# writable path and the target of the collector copy (<project>/data).
HQA_DATA_DIR=
# Optional backend (status publish, unknown orders, risk). Leave both empty to skip backend steps.
BACKEND_INTERNAL_BASE_URL=
HQA_INTERNAL_TOKEN=
# Extra alert channels, comma separated (the file channel is always on). Unknown names fail at startup.
HQA_ALERT_CHANNELS=
# Telegram (HQA_ALERT_CHANNELS=file,telegram): bot token and target chat id.
HQA_TELEGRAM_BOT_TOKEN=
HQA_TELEGRAM_CHAT_ID=
# Collector data source, set exactly one:
# same host (lab hqa-server): the collector data tree, copied read-only with rsync -a (e.g. /var/lib/hqa/data)
HQA_COLLECTOR_LOCAL_DIR=
# another host: user@host and an SSH key readable by hqa (scripts/ops/pull_collector_data.sh)
HQA_COLLECTOR_HOST=
HQA_COLLECTOR_SSH_KEY=
# OP001 readiness test (2026-10-27..30): backend user id of the COMPETITION PAPER account (never pf001).
HQA_READINESS_USER_ID=
